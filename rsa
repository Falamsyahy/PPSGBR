<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Rekam Sosial Anak - Jawa Barat</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Excel Export/Import -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <!-- Firebase SDKs (Compat Version for simple HTML integration) -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#f0f9ff', 100: '#e0f2fe', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1' }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .tab-content { display: none; animation: fadeIn 0.3s ease-in-out; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        
        /* CSS Khusus Print / Cetak */
        @media print {
            body * { visibility: hidden; }
            #global-print-container, #global-print-container * { visibility: visible; }
            #global-print-container { position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 0; box-shadow: none; border: none; }
            .no-print { display: none !important; }
            .page-break { page-break-before: always; }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col relative overflow-x-hidden">

    <!-- LAYER AUTHENTICATION (Ditampilkan jika belum login) -->
    <div id="auth-screen" class="fixed inset-0 bg-slate-900 z-[100] flex items-center justify-center p-4 transition-opacity duration-300">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden flex flex-col">
            <div class="bg-brand-600 p-6 text-center text-white">
                <i class="fa-solid fa-shield-halved text-4xl mb-3"></i>
                <h2 class="text-2xl font-bold">Portal Rekam Sosial</h2>
                <p class="text-brand-100 text-sm mt-1">Sistem Manajemen Kasus Terpadu</p>
            </div>
            <div class="p-8">
                <div id="auth-error-msg" class="hidden mb-4 p-3 bg-rose-50 border-l-4 border-rose-500 text-rose-700 text-xs rounded shadow-sm font-medium"></div>
                
                <form id="auth-form" onsubmit="handleAuth(event)" class="space-y-4">
                    <div id="auth-name-group" class="hidden">
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Nama Lengkap (Gelar)</label>
                        <input type="text" id="auth-name" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm" placeholder="Contoh: Budi Santoso, S.Tr.Sos">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Alamat Email</label>
                        <input type="email" id="auth-email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm" placeholder="peksos@jabarprov.go.id">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Kata Sandi (Min. 6 Karakter)</label>
                        <input type="password" id="auth-password" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm" placeholder="••••••••">
                    </div>
                    <button type="submit" id="auth-submit-btn" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-2.5 px-4 rounded-lg shadow transition-colors flex justify-center items-center gap-2">
                        Masuk ke Sistem <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    </button>
                </form>
                
                <div class="mt-6 text-center">
                    <button type="button" onclick="toggleAuthMode()" id="auth-toggle-btn" class="text-sm text-brand-600 hover:text-brand-800 font-medium transition-colors">
                        Belum punya akun? Daftar di sini
                    </button>
                </div>
                
                <div class="mt-8 border-t border-slate-200 pt-4 text-center">
                    <button type="button" onclick="openModal('modal-firebase-config')" class="text-xs text-slate-500 hover:text-slate-800 flex items-center justify-center gap-1 mx-auto">
                        <i class="fa-solid fa-gear"></i> Konfigurasi Database Firebase
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN APP LAYER (Ditampilkan setelah login) -->
    <div id="main-app" class="hidden flex-col min-h-screen">
        
        <!-- Navbar Toolbar -->
        <nav class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-10 no-print">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col xl:flex-row justify-between py-3 items-center gap-3">
                    <div class="flex items-center w-full xl:w-auto justify-center xl:justify-start">
                        <div class="flex-shrink-0 flex items-center gap-2 text-brand-600 mr-2">
                            <i class="fa-solid fa-hands-holding-child text-2xl"></i>
                            <span class="font-bold text-lg xl:text-xl tracking-tight hidden lg:block">Rekam Sosial Anak</span>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center justify-center gap-2 w-full xl:w-auto flex-1 xl:justify-end">
                        
                        <!-- Panel Admin Button (Khusus Admin) -->
                        <button id="btn-admin-panel" onclick="openAdminPanel()" class="hidden items-center justify-center gap-1.5 rounded-md bg-rose-600 px-3 py-1.5 text-xs sm:text-sm font-bold text-white shadow-sm hover:bg-rose-500 transition-colors animate-pulse" title="Panel Mutasi Kasus">
                            <i class="fa-solid fa-user-shield"></i> Panel Admin
                        </button>

                        <!-- Filter Angkatan -->
                        <select id="filter-angkatan" onchange="handleAngkatanFilter(this.value)" class="block w-32 sm:w-40 rounded-md border-0 py-1.5 pl-2 pr-6 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-xs sm:leading-6 bg-slate-50 font-medium shadow-sm cursor-pointer truncate" title="Filter Angkatan/Tahun">
                            <option value="">Semua Angkatan</option>
                        </select>

                        <!-- Filter Kabupaten/Kota Jabar -->
                        <select id="filter-wilayah" onchange="handleRegionFilter(this.value)" class="block w-32 sm:w-40 rounded-md border-0 py-1.5 pl-2 pr-6 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-xs sm:leading-6 bg-slate-50 font-medium shadow-sm cursor-pointer truncate" title="Filter Wilayah">
                            <option value="">Semua Wilayah</option>
                        </select>

                        <!-- Pemilih Anak -->
                        <select id="client-selector" onchange="handleClientChange(this.value)" class="block w-40 sm:w-48 rounded-md border-0 py-1.5 pl-3 pr-8 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm sm:leading-6 bg-white font-bold shadow-sm cursor-pointer truncate">
                            <!-- Options generated by JS -->
                        </select>
                        
                        <button onclick="openModal('modal-add-client')" class="inline-flex items-center justify-center gap-1.5 rounded-md bg-brand-50 px-2.5 py-1.5 text-xs sm:text-sm font-semibold text-brand-600 shadow-sm ring-1 ring-inset ring-brand-200 hover:bg-brand-100 transition-colors" title="Tambah Anak Baru">
                            <i class="fa-solid fa-user-plus"></i> <span class="hidden sm:inline">Baru</span>
                        </button>

                        <button onclick="openBulkStatusModal()" class="inline-flex items-center justify-center gap-1.5 rounded-md bg-amber-50 px-2.5 py-1.5 text-xs sm:text-sm font-semibold text-amber-700 shadow-sm ring-1 ring-inset ring-amber-200 hover:bg-amber-100 transition-colors" title="Ubah Status Massal">
                            <i class="fa-solid fa-tags"></i> <span class="hidden md:inline">Status</span>
                        </button>

                        <button onclick="openBulkDeleteModal()" class="inline-flex items-center justify-center gap-1.5 rounded-md bg-rose-50 px-2.5 py-1.5 text-xs sm:text-sm font-semibold text-rose-600 shadow-sm ring-1 ring-inset ring-rose-200 hover:bg-rose-100 transition-colors" title="Hapus Data Massal">
                            <i class="fa-solid fa-trash-can"></i> <span class="hidden md:inline">Hapus</span>
                        </button>

                        <button onclick="openModal('modal-data-management')" class="inline-flex items-center justify-center gap-1.5 rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs sm:text-sm font-semibold text-indigo-700 shadow-sm ring-1 ring-inset ring-indigo-200 hover:bg-indigo-100 transition-colors" title="Backup & Import">
                            <i class="fa-solid fa-database"></i> <span class="hidden md:inline">Data</span>
                        </button>
                        
                        <!-- Profile Peksos -->
                        <div class="relative flex items-center gap-2 border-l pl-3 ml-1 border-slate-300">
                            <button onclick="openModal('modal-edit-profile')" class="flex flex-col items-end hover:bg-slate-100 px-2 py-1 rounded transition-colors text-right cursor-pointer" title="Edit Profil Anda">
                                <span id="display-peksos-name" class="text-sm font-bold text-slate-800 leading-tight">Memuat...</span>
                                <span class="text-[10px] font-medium text-slate-500">Pekerja Sosial</span>
                            </button>
                            <button onclick="logout()" class="text-slate-400 hover:text-rose-600 p-1.5 rounded-full transition-colors" title="Keluar">
                                <i class="fa-solid fa-right-from-bracket"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full no-print">
            
            <div id="toast" class="fixed bottom-4 right-4 bg-emerald-500 text-white px-6 py-3 rounded-lg shadow-lg transform transition-transform duration-300 translate-y-20 opacity-0 z-50 flex items-center gap-3">
                <i id="toast-icon" class="fa-solid fa-circle-check"></i>
                <span id="toast-message">Notifikasi</span>
            </div>

            <!-- Profile Header -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition-all">
                <div class="flex items-center gap-5">
                    <img id="profile-avatar" src="https://placehold.co/150x150/e2e8f0/475569?text=A" alt="Avatar" class="w-16 h-16 rounded-full object-cover border-2 border-brand-100">
                    <div>
                        <h1 id="profile-nama" class="text-2xl font-bold text-slate-900">Memuat...</h1>
                        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-500 mt-1">
                            <span id="profile-id"><i class="fa-regular fa-id-card mr-1"></i> ID: -</span>
                            <span id="profile-umur"><i class="fa-solid fa-calendar-day mr-1"></i> - Tahun</span>
                            <span id="profile-gender"><i class="fa-solid fa-mars mr-1"></i> -</span>
                            <span id="profile-wilayah" class="text-brand-600 font-medium"><i class="fa-solid fa-map-location-dot mr-1"></i> -</span>
                            <span id="profile-angkatan-badge" class="text-indigo-600 font-bold"><i class="fa-solid fa-users-rectangle mr-1"></i> -</span>
                        </div>
                    </div>
                </div>
                <div>
                    <span id="profile-status" class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-500/10 shadow-sm">
                        Menunggu Data
                    </span>
                </div>
            </div>

            <!-- Tabs -->
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="border-b border-slate-200 overflow-x-auto">
                    <nav class="flex w-max min-w-full -mb-px px-2" aria-label="Tabs" id="tabs-nav">
                        <button onclick="switchTab('tab-profil')" class="tab-btn flex-1 min-w-[150px] py-4 px-1 text-center border-b-2 font-bold text-sm border-brand-500 text-brand-600" data-target="tab-profil">
                            <i class="fa-solid fa-file-medical mr-2"></i>Profil & Riwayat
                        </button>
                        <button onclick="switchTab('tab-asesmen')" class="tab-btn flex-1 min-w-[150px] py-4 px-1 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300" data-target="tab-asesmen">
                            <i class="fa-solid fa-clipboard-question mr-2"></i>Asesmen BPSS
                        </button>
                        <button onclick="switchTab('tab-intervensi')" class="tab-btn flex-1 min-w-[150px] py-4 px-1 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300" data-target="tab-intervensi">
                            <i class="fa-solid fa-hand-holding-heart mr-2"></i>Rencana & Log Intervensi
                        </button>
                        <button onclick="switchTab('tab-evaluasi')" class="tab-btn flex-1 min-w-[150px] py-4 px-1 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300" data-target="tab-evaluasi">
                            <i class="fa-solid fa-flag-checkered mr-2"></i>Evaluasi Akhir
                        </button>
                        <button onclick="switchTab('tab-cetak')" class="tab-btn flex-1 min-w-[150px] py-4 px-1 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300" data-target="tab-cetak">
                            <i class="fa-solid fa-print mr-2"></i>Pratinjau & Cetak
                        </button>
                    </nav>
                </div>

                <div class="p-6">
                    <!-- TAB 1: PROFIL & BIODATA -->
                    <div id="tab-profil" class="tab-content active">
                        <div class="bg-white rounded-lg border border-slate-200 mb-8 overflow-hidden shadow-sm">
                            
                            <!-- Kedatangan & Tingkat Risiko -->
                            <div class="bg-indigo-50 px-4 py-3 border-b border-indigo-100 flex justify-between items-center">
                                <h3 class="text-base font-semibold text-indigo-900 flex items-center gap-2">
                                    <i class="fa-solid fa-suitcase-rolling text-indigo-600"></i> Kedatangan & Kedaruratan
                                </h3>
                            </div>
                            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 bg-indigo-50/20">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Angkatan / Kelompok Masuk</label>
                                    <input type="text" id="form-biodata-angkatan" placeholder="Misal: Angkatan 1 - 2026" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm font-bold">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Barang Bawaan saat Datang</label>
                                    <textarea id="form-biodata-barangBawaan" rows="1" placeholder="Catat kelengkapan barang, dokumen, obat..." class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm"></textarea>
                                </div>
                                <div class="md:col-span-3 border-t border-indigo-100 pt-4 mt-2">
                                    <label class="block text-sm font-bold text-rose-700 mb-2"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Tingkat Risiko & Kedaruratan Anak (Red Flag)</label>
                                    <p class="text-[11px] text-slate-500 mb-2">Penilaian awal perlindungan anak (Child Safeguarding). Apakah ada ancaman kekerasan aktif, bunuh diri, atau kondisi medis kritis?</p>
                                    <select id="form-asesmen-tingkatRisiko" onchange="renderProfileCard()" class="block w-full max-w-sm rounded-md border-0 py-2 px-3 text-slate-900 font-bold shadow-sm ring-1 ring-inset ring-rose-300 focus:ring-2 focus:ring-rose-600 sm:text-sm">
                                        <option value="Rendah">Rendah (Aman / Stabil)</option>
                                        <option value="Sedang">Sedang (Perlu Perhatian Khusus)</option>
                                        <option value="Tinggi">Tinggi (Berada dalam Ancaman / Bahaya)</option>
                                        <option value="Kritis">Kritis (Kedaruratan Medis / Nyawa / Evakuasi)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Biodata Utama -->
                            <div class="bg-slate-50 px-4 py-3 border-y border-slate-200">
                                <h3 class="text-base font-semibold text-slate-900 flex items-center gap-2">
                                    <i class="fa-solid fa-address-card text-brand-500"></i> Biodata Dasar Klien
                                </h3>
                            </div>
                            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap</label>
                                    <input type="text" id="form-biodata-nama" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Wilayah / Kabupaten Kota</label>
                                    <select id="form-biodata-kabupatenKota" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                        <option value="">- Pilih Wilayah -</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Tempat Lahir</label>
                                    <input type="text" id="form-biodata-tempatLahir" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Tanggal Lahir</label>
                                    <input type="date" id="form-biodata-tanggalLahir" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Umur (Tahun - Otomatis)</label>
                                    <input type="number" id="form-biodata-umur" readonly class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-700 bg-slate-100 shadow-sm ring-1 ring-inset ring-slate-300 sm:text-sm cursor-not-allowed">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Jenis Kelamin</label>
                                    <select id="form-biodata-gender" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                        <option value="Laki-laki">Laki-laki</option>
                                        <option value="Perempuan">Perempuan</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Agama</label>
                                    <input type="text" id="form-biodata-agama" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama Orang Tua / Wali</label>
                                    <input type="text" id="form-biodata-namaWali" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">No. HP / Kontak Darurat</label>
                                    <input type="text" id="form-biodata-kontakWali" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
                                <div class="md:col-span-2 lg:col-span-3">
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Alamat Lengkap / Jalan</label>
                                    <textarea id="form-biodata-alamat" rows="2" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm"></textarea>
                                </div>
                            </div>

                            <!-- Pendidikan & Identitas -->
                            <div class="bg-slate-50 px-4 py-3 border-y border-slate-200 mt-2">
                                <h3 class="text-base font-semibold text-slate-900 flex items-center gap-2">
                                    <i class="fa-solid fa-graduation-cap text-brand-500"></i> Identitas & Pendidikan
                                </h3>
                            </div>
                            <div class="p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Status Identitas Fisik</label>
                                    <select id="form-biodata-statusIdentitas" class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                        <option value="">- Pilih -</option>
                                        <option value="Memiliki KTP/KIA">Memiliki KTP / KIA Fisik</option>
                                        <option value="Memiliki NIK (Tanpa Kartu)">Ada NIK (KK), Tanpa Kartu</option>
                                        <option value="Tanpa Identitas">Sama sekali Tanpa Identitas</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-1">Nomor Induk Kependudukan (NIK)</label>
                                    <input type="text" id="form-biodata-noIdentitas" placeholder="16 Digit NIK..." class="block w-full rounded-md border-0 py-1.5 px-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-brand-600 sm:text-sm">
                                </div>
