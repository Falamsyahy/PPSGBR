        function toggleAllBulkStatus(el) { document.querySelectorAll('input[name="bulk_status_cb"]').forEach(cb => cb.checked = el.checked); }
        async function executeBulkStatus() {
            const ids = Array.from(document.querySelectorAll('input[name="bulk_status_cb"]:checked')).map(cb => cb.value); 
            const st = document.getElementById('bulk-status-select').value;
            const r = document.getElementById('bulk-status-reason').value.trim();
            if (ids.length === 0 || !st) return showToast("Pilih min 1 anak & status baru!", "error");
            
            const batch = db.batch();
            ids.forEach(id => { 
                appState.clients[id].status = st; 
                if(!appState.clients[id].formData) appState.clients[id].formData={}; 
                appState.clients[id].formData.terminasiStatus = st;
                if(r) appState.clients[id].formData.terminasiAlasan = (appState.clients[id].formData.terminasiAlasan||"") + `\n[Mass Update]: ${r}`;
                batch.update(db.collection('clients').doc(id), appState.clients[id]);
            });
            await batch.commit(); closeModal('modal-bulk-status'); refreshUI(); showToast(`Berhasil update ${ids.length} data ke Cloud.`);
        }

        function openBulkDeleteModal() {
            const l = document.getElementById('bulk-delete-list'); l.innerHTML = ''; 
            const clients = getFilteredClients();
            if (clients.length === 0) l.innerHTML = '<div class="text-slate-400 italic text-center">Kosong.</div>';
            else clients.forEach(c => l.innerHTML += `<label class="flex gap-3 p-2 hover:bg-rose-50 border-b cursor-pointer"><input type="checkbox" name="bulk_delete_cb" value="${c.id}" class="rounded text-rose-600"><div><p class="text-sm font-bold">${c.nama}</p><p class="text-[10px] text-slate-500">${c.formData?.angkatan || '-'} | ID: ${c.id}</p></div></label>`);
            openModal('modal-bulk-delete');
        }
        function toggleAllBulkDelete(el) { document.querySelectorAll('input[name="bulk_delete_cb"]').forEach(cb => cb.checked = el.checked); }
        async function executeBulkDelete() {
            const ids = Array.from(document.querySelectorAll('input[name="bulk_delete_cb"]:checked')).map(cb => cb.value);
            if (ids.length === 0) return showToast("Pilih min 1 anak!", "error");
            
            const batch = db.batch();
            ids.forEach(id => { batch.delete(db.collection('clients').doc(id)); delete appState.clients[id]; if(appState.currentClientId===id) appState.currentClientId=null; });
            await batch.commit(); closeModal('modal-bulk-delete'); populateAngkatanDropdown(); initAppUI(); showToast(`${ids.length} data dihapus dr Cloud.`);
