        function handleRegionFilter(region) { currentRegionFilter = region; processFiltersChange(); }
        function handleAngkatanFilter(angkatan) { currentAngkatanFilter = angkatan; processFiltersChange(); }

        function processFiltersChange() {
            renderClientSelect();
            const filtered = getFilteredClients();
            if(filtered.length > 0) handleClientChange(filtered[0].id);
            else handleClientChange("");
        }

        function getFilteredClients() {
            return Object.values(appState.clients).filter(c => {
                const matchRegion = !currentRegionFilter || (c.formData && c.formData.kabupatenKota === currentRegionFilter);
                const matchAngkatan = !currentAngkatanFilter || (c.formData && c.formData.angkatan === currentAngkatanFilter);
                return matchRegion && matchAngkatan;
            });
        }

        function initAppUI() {
            renderClientSelect();
            const filtered = getFilteredClients();
            if(appState.currentClientId && !filtered.find(c => c.id === appState.currentClientId)) appState.currentClientId = null; 
            if (!appState.currentClientId && filtered.length > 0) appState.currentClientId = filtered[0].id;
            
            if (appState.currentClientId) {
                document.getElementById('client-selector').value = appState.currentClientId;
                refreshUI();
            } else clearUI();
        }

        function renderClientSelect() {
            const sel = document.getElementById('client-selector');
            sel.innerHTML = '';
            const clients = getFilteredClients();
            if (clients.length === 0) return sel.innerHTML = '<option value="">-- Kosong --</option>';
            clients.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id; opt.textContent = `${c.nama} (${c.id})`;
                if (c.id === appState.currentClientId) opt.selected = true;
                sel.appendChild(opt);
            });
        }

        function handleClientChange(newId) {
            if (!newId) { appState.currentClientId = null; clearUI(); return; }
