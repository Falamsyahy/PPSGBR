        function populateAngkatanDropdown() {
            const filterAngkatan = document.getElementById('filter-angkatan');
            const angkatanSet = new Set();
            Object.values(appState.clients).forEach(c => {
                if(c.formData && c.formData.angkatan && c.formData.angkatan.trim() !== '') {
                    angkatanSet.add(c.formData.angkatan.trim());
                }
            });
            const uniq = Array.from(angkatanSet).sort();
            filterAngkatan.innerHTML = '<option value="">Semua Angkatan</option>';
            uniq.forEach(a => {
                const opt = new Option(a, a);
                if(a === currentAngkatanFilter) opt.selected = true;
                filterAngkatan.add(opt);
