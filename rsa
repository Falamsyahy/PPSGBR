        window.exportToWord = function() {
            saveFormDataToState(); generateReportPreview();
            const nm = appState.clients[appState.currentClientId]?.nama || 'Klien';
            const html = `<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'><head><meta charset='utf-8'><title>Laporan BPSS</title><style>body { font-family: 'Times New Roman', Times, serif; font-size: 11pt; } table { width: 100%; border-collapse: collapse; margin-bottom: 12pt; } td, th { padding: 4pt; vertical-align: top; } table.border-collapse td, table.border-collapse th { border: 1pt solid black; } h2, h3 { font-weight: bold; } .text-center { text-align: center; } .font-bold { font-weight: bold; } .bg-gray-100 { background-color: #f3f4f6; } img { max-width: 100%; height: auto; display: block; margin: 0 auto; text-align: center; } .page-break { page-break-before: always; }</style></head><body>${document.getElementById('print-content').innerHTML}</body></html>`;
            const blob = new Blob(['\ufeff', html], { type: 'application/msword' }); 
            const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = `Laporan_BPSS_${nm.replace(/\s+/g, '_')}.doc`; document.body.appendChild(link); link.click(); document.body.removeChild(link);
        };

        function exportDataJSON() {
            const dataStr = JSON.stringify(appState.clients, null, 2);
            const link = document.createElement('a'); link.href = 'data:application/json;charset=utf-8,' + encodeURIComponent(dataStr);
            link.download = `Backup_RSA_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(link); link.click(); document.body.removeChild(link);
            closeModal('modal-data-management'); showToast("Data ter-ekspor (JSON)");
        }
        function processImportData(e) {
            const file = e.target.files[0]; if(!file) return;
            const r = new FileReader();
            r.onload = async function(ev) {
                try {
                    const data = JSON.parse(ev.target.result);
                    const batch = db.batch(); let c = 0;
                    for(let k in data) {
                        if(data[k].id && data[k].nama) {
                            if(!data[k].peksosEmail) data[k].peksosEmail = currentUser.email;
                            batch.set(db.collection('clients').doc(k), data[k]); c++;
                            appState.clients[k] = data[k];
                        }
                    }
                    if(c>0) { await batch.commit(); showToast(`Import ${c} anak JSON ke Cloud sukses.`); closeModal('modal-data-management'); populateAngkatanDropdown(); initAppUI(); }
                } catch(err) { showToast("Gagal baca JSON.", "error"); } e.target.value='';
            }; r.readAsText(file);
        }

        function downloadExcelTemplate() {
            if(typeof XLSX === 'undefined') return showToast("Lib Excel memuat..", "error");
            const ws = XLSX.utils.aoa_to_sheet([
                ["ID", "Angkatan", "Barang Bawaan", "Nama Lengkap", "Kabupaten/Kota", "Tempat Lahir", "Tanggal Lahir (YYYY-MM-DD)", "Gender", "Agama", "Alamat", "Status Kasus"],
                ["", "Gel 1 - 2026", "Tas, Baju", "Andi", "Kota Bandung", "Bandung", "2015-08-14", "Laki-laki", "Islam", "Jl Merdeka", "Kasus Aktif"]
            ]);
            ws['!cols'] = [{wch:15}, {wch:15}, {wch:20}, {wch:25}, {wch:20}, {wch:15}, {wch:25}, {wch:15}, {wch:15}, {wch:35}, {wch:15}];
            const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Template"); XLSX.writeFile(wb, "Template_Import.xlsx");
        }
        function processImportExcel(e) {
            const file = e.target.files[0]; if(!file) return;
            if(typeof XLSX === 'undefined') return showToast("Lib Excel error.", "error");
            const r = new FileReader();
            r.onload = async function(ev) {
                try {
                    const wb = XLSX.read(new Uint8Array(ev.target.result), {type: 'array'});
                    const js = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]]);
                    const batch = db.batch(); let c = 0;
                    js.forEach(r => {
                        const nama = r["Nama Lengkap"] || r["Nama"]; const kab = r["Kabupaten/Kota"] || r["KabupatenKota"];
                        if(nama && kab) {
                            let id = r["ID"]; if(!id) id = generateId();
                            if(!appState.clients[id]) appState.clients[id] = { riwayatPenyakit:[], layananDiberikan:[], pelaksanaanIntervensi:[], formData:{} };
                            const cli = appState.clients[id];
                            cli.id = id; cli.nama = nama; cli.gender = r["Gender"] || "Laki-laki"; cli.umur = calculateAge(r["Tanggal Lahir (YYYY-MM-DD)"]);
                            cli.status = r["Status Kasus"] || "Kasus Aktif"; cli.peksosEmail = (currentUser.email === ADMIN_EMAIL) ? POOL_EMAIL : currentUser.email;
                            cli.formData.kabupatenKota = kab; cli.formData.angkatan = r["Angkatan"]||""; cli.formData.barangBawaan = r["Barang Bawaan"]||""; cli.formData.tempatLahir = r["Tempat Lahir"]||""; cli.formData.tanggalLahir = r["Tanggal Lahir (YYYY-MM-DD)"]||""; cli.formData.agama = r["Agama"]||""; cli.formData.alamat = r["Alamat"]||"";
                            batch.set(db.collection('clients').doc(id), cli); c++;
                        }
                    });
                    if(c>0) { await batch.commit(); showToast(`Import ${c} anak via Excel sukses.`); closeModal('modal-data-management'); populateAngkatanDropdown(); initAppUI(); }
                } catch(err) { showToast("Excel korup/salah", "error"); } e.target.value='';
            }; r.readAsArrayBuffer(file);
        }
    </script>
