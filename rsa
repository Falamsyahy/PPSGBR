        function handleAuth(e) {
            e.preventDefault();
            if(!firebase.apps.length) return showAuthError("Harap isi konfigurasi Firebase terlebih dahulu!");
            
            const email = document.getElementById('auth-email').value.trim();
            const pass = document.getElementById('auth-password').value;
            const name = document.getElementById('auth-name').value.trim();
            
            const btn = document.getElementById('auth-submit-btn');
            btn.disabled = true; btn.style.opacity = 0.7;

            if (isRegisterMode) {
                firebase.auth().createUserWithEmailAndPassword(email, pass)
                    .then(cred => {
                        return db.collection('users').doc(email).set({
                            email: email, nama: name, nip: '', namaSupervisor: '', nipSupervisor: '', jabatanSupervisor: ''
                        });
                    })
                    .catch(err => {
                        if(err.code === 'auth/operation-not-allowed') {
                            showAuthError(`Firebase Project Anda melarang pendaftaran. <br>Buka Firebase Console > Authentication > Sign-in method > Aktifkan (Enable) Email/Password.`);
                        } else { showAuthError(err.message); }
                    })
                    .finally(() => { btn.disabled = false; btn.style.opacity = 1; });
            } else {
                firebase.auth().signInWithEmailAndPassword(email, pass)
                    .catch(err => {
                        let msg = err.message;
                        if(err.code === 'auth/invalid-credential') msg = "Kombinasi Email dan Kata Sandi tidak cocok.";
                        showAuthError(msg);
                    })
                    .finally(() => { btn.disabled = false; btn.style.opacity = 1; });
            }
        }

