            if(ids.length === 0 || !target) return showToast("Pilih data dan Peksos tujuan!", "error");
            
            const batch = db.batch();
            ids.forEach(id => {
                appState.clients[id].peksosEmail = target;
                batch.update(db.collection('clients').doc(id), {peksosEmail: target});
