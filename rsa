            isRegisterMode = !isRegisterMode;
            const nameGrp = document.getElementById('auth-name-group');
            const btn = document.getElementById('auth-submit-btn');
            const toggleBtn = document.getElementById('auth-toggle-btn');
            
            if (isRegisterMode) {
                nameGrp.classList.remove('hidden');
                document.getElementById('auth-name').required = true;
                btn.innerHTML = 'Daftarkan Akun <i class="fa-solid fa-user-plus"></i>';
                btn.classList.replace('bg-brand-600', 'bg-emerald-600');
                btn.classList.replace('hover:bg-brand-700', 'hover:bg-emerald-700');
                toggleBtn.textContent = 'Sudah punya akun? Masuk (Login)';
            } else {
                nameGrp.classList.add('hidden');
                document.getElementById('auth-name').required = false;
                btn.innerHTML = 'Masuk ke Sistem <i class="fa-solid fa-arrow-right-to-bracket"></i>';
